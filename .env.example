# Copy this file to .env and fill it in:  cp .env.example .env

# The port the app listens on. Point your Cloudflare Tunnel (or Caddy) at it.
PORT=3000
# Which address to listen on. 127.0.0.1 = only this machine (use with a tunnel on the same server).
# Set to 0.0.0.0 if the tunnel runs on a different machine and connects to this server's internal IP.
HOST=127.0.0.1

# Your site's address, used for "Share my ride" links.
PUBLIC_URL=https://dash.example.com

# PostgreSQL connection. Change the password to the one you set.
DATABASE_URL=postgres://dekaiah:CHANGE_ME@127.0.0.1:5432/dekaiah_dash

# Your email. Whoever logs in with this email (using Google) becomes the driver.
DRIVER_EMAIL=you@gmail.com

# Your time zone, used for times in text messages. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Toronto

# Firebase (login). From Firebase console > Project settings > Your apps > Web app.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Set this to your own domain (e.g. dash.example.com) so Google login works on iPhones. See README.
FIREBASE_AUTH_DOMAIN=

# Phone notifications. Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@gmail.com

# Text messages through Twilio (optional; leave blank to turn texts off).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, like +15551234567
TWILIO_FROM=
# Added to 10-digit phone numbers people type in. +1 is the US and Canada.
SMS_COUNTRY_CODE=+1

# Where the driver's profile photo is saved.
UPLOAD_DIR=uploads
